rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (shared viewer OR an admin) — gates public read access.
    function isSignedIn() {
      return request.auth != null;
    }
    // An admin is any authenticated user that is NOT the shared read-only viewer account.
    function isAdmin() {
      return request.auth != null && request.auth.token.email != 'viewer@shivzuk.app';
    }

    // ─── Default: admins only. Reading now requires authentication everywhere. ───
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── Core collections: readable by any signed-in user (viewer or admin) ───
    match /soldiers/{id}            { allow read: if isSignedIn(); }
    match /schedules/{id}           { allow read: if isSignedIn(); }
    match /tasks/{id}               { allow read: if isSignedIn(); }
    match /assignments/{id}         { allow read: if isSignedIn(); }
    match /task_types/{id}          { allow read: if isSignedIn(); }
    match /published_versions/{id}  { allow read: if isSignedIn(); }
    match /conditions/{id}          { allow read: if isSignedIn(); }

    // ─── Leave requests (soldiers submit) ────────────────────────────────────
    // Signed-in users can CREATE only pending, non-final requests.
    match /leave_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                 && request.resource.data.status == 'pending'
                 && request.resource.data.is_final == false;
      allow update, delete: if isAdmin();
    }

    // ─── Inquiries (soldiers send messages to admin) ──────────────────────────
    // Signed-in users can create new inquiries (must start with read=false).
    // Only admin can read/update/delete.
    match /inquiries/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.read == false;
      allow update, delete: if isAdmin();
    }

    // ─── Leave versions / settings ────────────────────────────────────────────
    match /leave_versions/{id} {
      allow read, write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
